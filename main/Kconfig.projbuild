menu "OS project demonstrations"
    config APP_LEGACY_POOL_DEMO
        bool "Run the original fixed-block pool demo"
        default n
    config APP_INTERACTIVE_HEAP_LAB
        bool "Interactive heap lab over UART"
        depends on ESP_CONSOLE_UART && !APP_LEGACY_POOL_DEMO
        default n
        help
            Run the UART interface for tools/heap_lab.py. Turn this off to run
            the automated experiment suite at boot.
    config APP_EXPERIMENT_REPEATS
        int "Repetitions per policy and scenario"
        range 1 20
        default 3
    config AH_SKIP_PER_CALL_VALIDATION
        bool "Skip invariant validation inside each ah_alloc/ah_free (latency measurement)"
        default n
        help
            Off (default): every ah_alloc/ah_free walks the whole arena to check
            invariants, as in the original design. TIMING rows then include that walk.
            On: the walk is skipped inside ah_alloc/ah_free; experiments still call
            ah_validate() at round boundaries. Use only for latency measurement runs.
endmenu
